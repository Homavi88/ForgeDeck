# PulseForge — environment template
# Copy to `.env` for local Docker / backend. Never commit real secrets.

# --- App ---
APP_NAME=PulseForge
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Database ---
# Local default: SQLite. Docker Compose overrides this to PostgreSQL.
DATABASE_URL=sqlite:///./pulseforge.db
# Production example:
# DATABASE_URL=postgresql+psycopg://pulseforge:pulseforge@postgres:5432/pulseforge

# --- Redis / workers ---
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# --- Storage ---
STORAGE_DIR=../storage/audio
MAX_UPLOAD_MB=80

# --- Audio analysis ---
# librosa is optional; numpy/soundfile fallback is always used if missing.
ENABLE_LIBROSA=true

# --- AI ---
# mock | openai | anthropic | gemini | local
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=
AI_MODEL=mock-producer-v1

# --- Demo user / auth ---
DEMO_USER_EMAIL=producer@pulseforge.local
DEMO_USER_NAME=Demo Producer
DEMO_USER_PASSWORD=demo
REQUIRE_AUTH=false
JWT_EXPIRE_HOURS=168

# --- Object storage (optional) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=pulseforge

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
